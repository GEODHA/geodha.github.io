# GEODHA Environment Variables — copy to .env and fill in real values
# NEVER commit .env to git. All secrets are stored in GitHub Secrets / CI environment variables.

# ── Firebase Configuration ──
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_VAPID_KEY=your_vapid_key_for_push_notifications

# ── Maps ──
# Optional basemap override (defaults to OpenStreetMap tiles, no API key needed).
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors

# ── Report Form ──
# External form URL for /report page submissions.
# If set, the form redirects here on submit instead of the placeholder handler.
# TODO: wire to Firebase reporting pipeline — remove this env var when pipeline is live.
VITE_REPORT_FORM_URL=

# ── Optional: Google Maps API ──
# Used only for place search in the Neighbourhood Scorecard (needs the
# "Places API (New)" enabled and HTTP-referrer restricted to geodha.org).
# Without it, search falls back to OpenStreetMap (Photon) geocoding.
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
